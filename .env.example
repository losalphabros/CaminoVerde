# ── Meta WhatsApp Business ─────────────────────────────────────────
# Token de acceso permanente de tu app en Meta Developers
WHATSAPP_TOKEN=EAAxxxxxxxxxxxxxxxxxxxxxxxx

# ID del número de teléfono en Meta (NO es el número, es el ID interno)
PHONE_NUMBER_ID=123456789012345

# Token que tú inventas para verificar el webhook (puede ser cualquier palabra)
VERIFY_TOKEN=caminoverde2024

# ── Google Sheets ──────────────────────────────────────────────────
# ID del Google Sheet (está en la URL: docs.google.com/spreadsheets/d/ESTE_ID/edit)
SPREADSHEET_ID=1Bxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Credenciales de la cuenta de servicio de Google (JSON completo en una sola línea)
GOOGLE_CREDS={"type":"service_account","project_id":"...","private_key":"..."}
